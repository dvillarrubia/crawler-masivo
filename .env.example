POSTGRES_USER=crawler
POSTGRES_PASSWORD=crawler
POSTGRES_DB=crawler_db

DATABASE_URL=postgresql+psycopg2://crawler:crawler@postgres:5432/crawler_db
REDIS_URL=redis://redis:6379/0

DEFAULT_MAX_DEPTH=3
DEFAULT_MAX_URLS=50000
DEFAULT_CONCURRENT_REQUESTS=32
DEFAULT_CONCURRENT_REQUESTS_PER_DOMAIN=8
DEFAULT_USER_AGENT=SEOCrawler/1.0

API_HOST=0.0.0.0
API_PORT=8000

# Playwright / JS rendering resource caps (only apply when render_js=true)
# Increase these on VPS with more resources (see docker-compose.prod.yml)
JS_CONCURRENT_REQUESTS=4
JS_CONCURRENT_PER_DOMAIN=4
PLAYWRIGHT_MAX_PAGES=4

# Ingesta de sitemaps (subir en CMS que parten el sitemap por plantilla)
MAX_SITEMAP_FILES=500

# Tope (s) del Crawl-delay de robots.txt que se respeta en robots_mode=respect
ROBOTS_CRAWL_DELAY_MAX=10

# Comprobacion automatica de render JS al cerrar un rastreo sin render_js
JS_CHECK_ENABLED=1
JS_CHECK_TEMPLATES=5
JS_CHECK_SAMPLES=1

# Credenciales de las integraciones de cada cliente (#36, decision 83 de
# CLAUDE.md). NUNCA se guardan en la base de datos: en la ficha del cliente se
# escribe el NOMBRE de la variable y aqui va el valor. Cada tipo exige su
# prefijo (GSC_, DATAFORSEO_, AHREFS_, SEMRUSH_, MAJESTIC_, PAGESPEED_).
# DATAFORSEO_LIN3S=login:password
# AHREFS_LIN3S=
