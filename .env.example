POSTGRES_USER=crawler
POSTGRES_PASSWORD=crawler
POSTGRES_DB=crawler_db

DATABASE_URL=postgresql+psycopg2://crawler:crawler@postgres:5432/crawler_db
REDIS_URL=redis://redis:6379/0

DEFAULT_MAX_DEPTH=3
DEFAULT_MAX_URLS=50000
DEFAULT_CONCURRENT_REQUESTS=32
DEFAULT_CONCURRENT_REQUESTS_PER_DOMAIN=8
DEFAULT_USER_AGENT=SEOCrawler/1.0

API_HOST=0.0.0.0
API_PORT=8000

# Playwright / JS rendering resource caps (only apply when render_js=true)
# Increase these on VPS with more resources (see docker-compose.prod.yml)
JS_CONCURRENT_REQUESTS=4
JS_CONCURRENT_PER_DOMAIN=4
PLAYWRIGHT_MAX_PAGES=4

# Ingesta de sitemaps (subir en CMS que parten el sitemap por plantilla)
MAX_SITEMAP_FILES=500
# Filas de sitemap_entries (fichero y lastmod de cada URL) por rastreo (decision 126)
SITEMAP_ENTRIES_MAX=250000

# Tope (s) del Crawl-delay de robots.txt que se respeta en robots_mode=respect
ROBOTS_CRAWL_DELAY_MAX=10

# Comprobacion automatica de render JS al cerrar un rastreo sin render_js
JS_CHECK_ENABLED=1
JS_CHECK_TEMPLATES=5
JS_CHECK_SAMPLES=1

# Credenciales de las integraciones de cada cliente (#36, decision 83 de
# CLAUDE.md). NUNCA se guardan en la base de datos: en la ficha del cliente se
# escribe el NOMBRE de la variable y aqui va el valor. Cada tipo exige su
# prefijo (GSC_, DATAFORSEO_, AHREFS_, SEMRUSH_, MAJESTIC_, PAGESPEED_).
# DATAFORSEO_LIN3S=login:password
# AHREFS_LIN3S=

# Capa de decisiones: Jev a traves de OpenRouter (#7, decision 84 de CLAUDE.md).
# La clave va AQUI y nunca en la base de datos. Sin clave, o con
# DECISIONS_ENABLED=0 (por defecto), no se llama a nadie: todo queda
# `sin_decidir`. Ni con las dos puestas se dispara nada solo (lo lanza #40).
# Sin comentarios en la misma linea: un float("0.042  # ...") revienta.
DECISIONS_ENABLED=0
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# HTTP-Referer y X-OpenRouter-Title: agrupan el uso en el panel de OpenRouter.
OPENROUTER_APP_URL=
OPENROUTER_APP_TITLE=SEO Crawler
# Peticiones/min. El limite real de Jev a traves de OpenRouter no esta
# publicado (TypeSafe directo: 80/s); se sube midiendo.
LLM_RPM=600
LLM_MAX_CONCURRENCIA=16
# Por llamada; los reintentos tienen ademas un tope de 30 s.
LLM_TIMEOUT_S=15
# Dias en la cache de Redis (la de la tabla `decisions` no caduca).
LLM_CACHE_TTL_D=30
# 1 = exigir retencion cero. Si el endpoint no la ofreciera, la llamada FALLA.
LLM_ZDR=0
# Solo para la reserva y cuando falta usage.cost (verificado el 2026-10-13).
JEV_PRECIO_USD_MTOK=0.042
# Tope global de gasto al mes en USD; vacio = sin tope global.
ENRICHMENT_MAX_USD_MES=

# Analisis enriquecido (#40, decision 85). Lanzar una ejecucion de pago
# exige la cabecera X-Enrichment-Token igual a esto; vacio (o con menos de 16
# caracteres) = lanzamiento DESACTIVADO, nunca abierto. Solo en la API.
ENRICHMENT_TOKEN=
# Worker: ejecuciones a la vez (pool propio, no quita huecos a los rastreos),
# URLs por lote y minutos sin latido tras los que una ejecucion se reencola.
MAX_CONCURRENT_ENRIQUECIDOS=1
ENRICHMENT_LOTE=200
ENRICHMENT_STALE_MINUTES=15

# Search Console (decision 141). La llave se sube desde la ficha del cliente
# y va a SECRETOS_DIR (volumen `secretos`), o se pone a mano como GSC_<NOMBRE>.
SECRETOS_DIR=/secretos
SEARCH_CONSOLE_DIAS_INICIALES=90   # dias que se bajan la primera vez
SEARCH_CONSOLE_INSPECCIONES_DIA=500 # inspeccion de URLs por propiedad y dia (decision 144); 0 = apagada

# Extraccion a medida (#34, decision 104). Tope de lo que las reglas pueden
# guardar por pagina, timeout de cada regex, presupuesto de todas las reglas de
# una pagina y cuantos timeouts desactivan una regla el resto del rastreo.
CUSTOM_EXTRACTION_MAX_BYTES_PAGINA=65536
CUSTOM_EXTRACTION_TIMEOUT_MS=50
CUSTOM_EXTRACTION_PRESUPUESTO_MS=250
CUSTOM_EXTRACTION_AGOTADOS=3
CUSTOM_EXTRACTION_PRUEBAS_A_LA_VEZ=2

# --- Comparacion entre censos y avisos -------------------------------------
# Un webhook generico al que se manda un JSON cuando la comparacion con el
# censo anterior encuentra alertas CRITICAS. Vale tal cual para un incoming
# webhook de Slack o para un flujo de n8n que lo reenvie a correo. Vacio = no
# se avisa. Solo salen las criticas: un aviso semanal con cosas que no hay que
# mirar se deja de leer.
ALERTA_WEBHOOK_URL=
ALERTA_TIMEOUT_SEGUNDOS=10
API_PUBLIC_URL=                  # para que el enlace del aviso lleve a algun sitio

# Si el censo de referencia se analizo con otro codigo, se vuelve a analizar
# antes de comparar las incidencias. Sin esto el diff se calla casi siempre
# —se despliega a diario—, pero OJO: cambia las cifras guardadas de ese censo.
REANALIZAR_LA_REFERENCIA=1

# --- Rastreos programados --------------------------------------------------
PROGRAMACION_INTERVAL_SECONDS=60 # cada cuanto mira el worker si toca lanzar
PROGRAMACION_GRACIA_HORAS=12     # cuanto puede llegar tarde un disparo perdido
PROGRAMACION_ZONA=Europe/Madrid  # zona por defecto de una programacion nueva

# Autenticacion de la API (decision 134). Sin API_TOKEN (minimo 24
# caracteres) la API responde 503: cerrada, nunca abierta por omision.
# Generar con: openssl rand -hex 24. Los scripts lo mandan como
# "Authorization: Bearer <token>"; el navegador entra en /entrar.
API_TOKEN=
API_AUTH_DESACTIVADA=0           # 1 = sin autenticacion (solo desarrollo local)
CORS_ORIGINS=                    # origenes permitidos, por comas; vacio = ninguno
