{
  "_seeds": [
    "https://www.ejemplo.com/"
  ],
  "_doc": "Copia esta carpeta como projects/<cliente>/ y ajusta. Las claves que empiezan por _ no se envian a la API.",
  "max_depth": 6,
  "max_urls": 60000,
  "follow_external": false,
  "robots_mode": "respect",
  "render_js": false,
  "concurrent_requests": 4,
  "concurrent_requests_per_domain": 2,
  "exclude_patterns": [],
  "include_patterns": [],
  "use_sitemap": true,
  "templates": [
    {
      "nombre": "legal",
      "patron": "(aviso-legal|privacidad|privacy|cookies)"
    },
    {
      "nombre": "home",
      "patron": "^/?$|^/[a-z]{2}/?$"
    }
  ],
  "segmentos": [
    {
      "nombre": "rotas",
      "si": {
        "campo": "status_group",
        "en": [
          "4xx",
          "5xx"
        ]
      }
    },
    {
      "nombre": "blog",
      "patron": "^/blog/"
    },
    {
      "nombre": "legal",
      "patron": "(aviso-legal|privacidad|privacy|cookies)"
    }
  ],
  "_marcas": "Clave opcional \"marcas\": lista de nombres de marca del cliente (decision 157); sus busquedas no cuentan en la curva de CTR ni como canibalizacion de la home. Va mejor en la ficha del cliente. Si la pones aqui, la lista SUSTITUYE a la del cliente: no la pongas vacia, que borra las suyas.",
  "resource_types": {
    "crawl_images": false,
    "crawl_css": false,
    "crawl_js": false,
    "crawl_pdfs": false,
    "crawl_fonts": false,
    "crawl_svg": false,
    "crawl_other": false,
    "check_external_resources": false
  },
  "crawl_behavior": {
    "download_timeout": 30,
    "retry_count": 2,
    "request_delay": 0.5,
    "autothrottle_enabled": true,
    "autothrottle_target_concurrency": 4.0,
    "follow_nofollow": false,
    "crawl_subdomains": false,
    "max_runtime_hours": 48,
    "stall_timeout_minutes": 30,
    "respetar_retry_after": true,
    "sonda_tls": true,
    "paridad_movil_muestra": 0,
    "paridad_movil_por_plantilla": 3,
    "paridad_movil_ua": "chrome_android",
    "comprobar_enlaces_externos": false,
    "enlaces_externos_max": 5000,
    "comprobar_recursos": false,
    "recursos_max": 20000,
    "sondas_por_host": 50,
    "og_image_muestra": 200,
    "og_image_por_plantilla": 5
  },
  "extraction": {
    "extract_structured_data": true,
    "extract_hreflang": true,
    "extract_security_headers": true,
    "extract_page_content": true,
    "strip_promo_blocks": true,
    "custom_boilerplate_selectors": [],
    "store_raw_html": false
  },
  "http": {
    "accept_language": "es,en;q=0.8",
    "conservar_cookies": false
  },
  "adapters": {
    "wordpress": {
      "modo": "auto",
      "max_concurrencia": 2,
      "max_peticiones": 1000,
      "max_minutos": 20,
      "max_entidades_por_tipo": 20000,
      "max_medios": 1000,
      "muestra_adjuntos": 20,
      "sondas_paginacion": 5
    }
  },
  "_analysis_thresholds": "Clave opcional \"analysis_thresholds\" (decision 157): umbrales de Search Console, que se fusionan clave a clave con los del cliente; pon solo los que cambien, porque uno puesto aqui gana al del cliente. Por defecto: gsc_oportunidad_min_impresiones 500, gsc_oportunidad_posicion_min 4.0, gsc_oportunidad_posicion_max 20.0, gsc_oportunidad_profundidad 4, gsc_ctr_min_impresiones 200, gsc_ctr_min_clics_que_faltan 20, gsc_canibalizacion_min_parte 0.2, gsc_canibalizacion_min_clics 10, gsc_canibalizacion_min_impresiones 1000, gsc_canibalizacion_clics_grave 100."
}
