# Contenedor del pipeline de entidades GLiNER2 (CPU). Separado a propósito:
# torch + pesos del modelo no deben engordar las imágenes api/crawler.
#
# Por defecto arranca el worker residente (cola Redis, disparo automático):
#   docker compose --profile gliner up -d
# Ejecución manual puntual:
#   docker compose --profile gliner run --rm gliner \
#       python -m analysis.entities.run --job-id <uuid>
FROM python:3.12-slim

WORKDIR /app

# torch en su propia capa: es lo pesado y así los cambios de requirements
# no obligan a re-descargarlo
RUN pip install --no-cache-dir "torch>=2.2" --extra-index-url https://download.pytorch.org/whl/cpu

COPY requirements-gliner.txt .
RUN pip install --no-cache-dir -r requirements-gliner.txt

COPY shared/ shared/
COPY analysis/ analysis/
COPY config/ config/

ENV PYTHONPATH=/app
CMD ["python", "-m", "analysis.entities.worker"]
